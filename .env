# Публичные значения по умолчанию, хранятся в git. Локально переопределяйте в .env.local (игнорируется git).
# Никогда не храните здесь секреты: каждая переменная VITE_ попадает в клиентский бандл.
VITE_APP_TITLE=Frontend подготовка
VITE_API_URL=/api

# Публичный URL сайта с базовым путём: canonical-ссылки, sitemap.xml, Open Graph
VITE_SITE_URL=https://leaderdsn.github.io/vue-interview-prep
