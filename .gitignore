# Зависимости
node_modules
# Lock-файл обязательно коммитится (перекрывает глобальные правила игнорирования на некоторых машинах)
!pnpm-lock.yaml

# Результаты сборки
dist
dist-ssr
coverage
*.local
*.tsbuildinfo
.eslintcache

# Env: в .env лежат публичные значения по умолчанию (в git); локальные переопределения — в .env.local / .env.*.local
.env.local
.env.*.local


# Логи
logs
*.log
npm-debug.log*

# Редактор
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.sw?

# Локальный кэш инструмента индексации кода graft
graft/.cache/

# Личный план доработки, в репозиторий не попадает
docs/ROADMAP.md
