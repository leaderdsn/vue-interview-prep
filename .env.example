# All supported variables. Copy to .env.local to override the defaults from .env.
# Only variables prefixed with VITE_ are exposed to the client — never put secrets here.

# Application title shown in the header and <title>
VITE_APP_TITLE=Vue Interview Prep

# Base URL for the HTTP client (src/shared/api)
VITE_API_URL=/api

# Firebase sync of progress between devices via Google sign-in (optional; leave empty to stay local).
# The web config is public by design; access is limited by database.rules.json to the signed-in user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
