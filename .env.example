# Все поддерживаемые переменные. Скопируйте в .env.local, чтобы переопределить значения по умолчанию из .env.
# Клиенту доступны только переменные с префиксом VITE_ — никогда не храните здесь секреты.

# Название приложения в шапке и в <title>
VITE_APP_TITLE=Frontend подготовка

# Базовый URL для HTTP-клиента (src/shared/api)
VITE_API_URL=/api

# Публичный URL сайта с базовым путём, без завершающего слэша: canonical-ссылки, sitemap.xml, Open Graph
VITE_SITE_URL=https://leaderdsn.github.io/vue-interview-prep

# Синхронизация прогресса между устройствами через Firebase и вход через Google (необязательно;
# оставьте пустым, чтобы работать локально).
# Веб-конфиг публичен по замыслу; доступ ограничен вошедшим пользователем через database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics 4 через Firebase Analytics (необязательно). Собирает статистику только после согласия посетителя.
VITE_FIREBASE_MEASUREMENT_ID=

# Отчёты GA4 в админке (необязательно): числовой id ресурса GA4 и Client ID OAuth-клиента «Web application»
# из Google Cloud Console. Оба значения публичные; доступ к данным даёт только вход администратора в Google.
VITE_GA_PROPERTY_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
